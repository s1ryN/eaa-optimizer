# API
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
AUTH_REQUIRED=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Queue signing
JOB_SIGNING_SECRET=replace-with-a-long-random-secret

# API auth (set at least one in production)
SCAN_API_KEY=
SCAN_BEARER_TOKEN=

# API limits
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW=1 minute
API_CREATE_SCAN_RATE_LIMIT_MAX=20
API_CREATE_SCAN_RATE_LIMIT_WINDOW=1 minute
API_BODY_LIMIT_BYTES=131072
API_MAX_PARAM_LENGTH=200

# Worker
WORKER_CONCURRENCY=2
CRAWLER_MAX_PAGES=50
CRAWLER_PARALLEL_PAGES=4
CRAWLER_PAGE_TIMEOUT=30000
CRAWLER_REQUEST_DELAY_MS=350
CRAWLER_REQUEST_JITTER_MS=400
CRAWLER_BAN_COOLDOWN_MS=12000
CRAWLER_MAX_BAN_SIGNALS=3
CRAWLER_SIMILAR_PATTERN_LIMIT=3
CRAWLER_PAGINATION_PATTERN_LIMIT=8
CRAWLER_DEDUPLICATE_BY_DEFAULT=true
WCAG_CONFORMANCE_TARGET=AA
WCAG_AXE_INCLUDE_IFRAMES=false
